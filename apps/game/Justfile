export PATH := env("HOME") / "go/bin:" + env("PATH")

proto_root := "../../packages/protocol/proto"
pb_go_out := "./internal/pb"

# Generate Go code from proto files
proto:
    @mkdir -p {{pb_go_out}}
    @rm -f {{pb_go_out}}/*.pb.go
    protoc \
        --proto_path={{proto_root}}/v1 \
        --go_out={{pb_go_out}} \
        --go_opt=paths=source_relative \
        {{proto_root}}/v1/messages.proto

# Build the server binary
build:
    go build -o bin/game-server .

# Run the server in development
run *args:
    go run . {{args}}

# Run tests
test *args:
    go test ./... {{args}}

# Clean build artifacts
clean:
    rm -rf bin/
