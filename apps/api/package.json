{
  "name": "carrier-api",
  "module": "src/index.ts",
  "type": "module",
  "exports": {
    "./contract": "./src/orpc/compat/contract.ts",
    "./types": "./src/orpc/compat/types.ts"
  },
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "evaluate:map-data": "bun src/maps/height-encoding-report.ts",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "lint": "eslint --cache src",
    "lint:fix": "eslint --fix src",
    "outdated": "bunx npm-check-updates --interactive --format group",
    "preview": "bun ./dist/index.html",
    "unused": "knip",
    "coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov",
    "test": "bun test"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@nkzw/eslint-config": "^3.3.0",
    "@types/bun": "latest",
    "@types/node": "^25.3.5",
    "eslint": "^10.0.2",
    "knip": "^5.85.0",
    "prettier": "^3.8.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@elysiajs/bearer": "^1.4.3",
    "@elysiajs/cors": "^1.4.1",
    "@orpc/client": "^1.13.6",
    "@orpc/contract": "^1.13.6",
    "@orpc/openapi": "^1.13.6",
    "@orpc/server": "^1.13.6",
    "@orpc/zod": "^1.13.6",
    "carrier-contracts": "workspace:*",
    "elysia": "^1.4.27",
    "odgn-query": "^0.3.1",
    "odgn-ts-helpers": "^0.2.0",
    "zod": "^4.3.6"
  }
}
