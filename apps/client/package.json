{
  "name": "carrier-client",
  "private": true,
  "version": "0.8.1",
  "type": "module",
  "scripts": {
    "dev": "bun ./index.html",
    "build": "bun run build.ts",
    "prepare": "bun run scripts/setup-git-hooks.ts",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "lint": "eslint --cache src",
    "lint:fix": "eslint --fix src",
    "outdated": "bunx npm-check-updates --interactive --format group",
    "preview": "bun ./dist/index.html",
    "typecheck": "bunx tsc --noEmit",
    "unused": "knip",
    "coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov",
    "test": "bun test"
  },
  "dependencies": {
    "@orpc/client": "^1.13.14",
    "@orpc/contract": "^1.13.14",
    "@orpc/openapi-client": "^1.13.14",
    "@react-spring/three": "^10.0.3",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.0",
    "@tanstack/query-async-storage-persister": "^5.99.0",
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-query-persist-client": "^5.99.0",
    "@tanstack/react-router": "^1.168.22",
    "@tanstack/react-router-devtools": "^1.166.13",
    "carrier-contracts": "workspace:*",
    "carrier-terrain-edit": "workspace:*",
    "clsx": "^2.1.1",
    "jotai": "^2.19.1",
    "leva": "^0.10.1",
    "mitt": "^3.0.1",
    "odgn-ts-helpers": "^0.2.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "three": "^0.183.2",
    "three-stdlib": "^2.36.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@nkzw/eslint-config": "^3.3.0",
    "@react-three/eslint-plugin": "^0.1.2",
    "@tailwindcss/postcss": "^4.2.2",
    "@tanstack/react-query-devtools": "^5.99.0",
    "@tanstack/router-cli": "^1.166.33",
    "@tanstack/router-plugin": "^1.167.22",
    "@types/bun": "^1.3.12",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.1",
    "eslint": "^10.2.0",
    "knip": "^6.4.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "bun-plugin-tailwind": "^0.1.2"
  }
}
