# Loaded by `bun run dev` and Playwright’s admin webServer so Bun can inline
# `process.env.PUBLIC_API_URL` in the browser bundle (see bunfig `[serve.static] env`).
# Leave empty to use the default API URL in `src/lib/api-client.ts`.
# Playwright sets PUBLIC_API_URL when starting the e2e admin server.
PUBLIC_API_URL=
