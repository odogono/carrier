{
  "name": "carrier-admin",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "bun ./index.html",
    "build": "bun run build.ts",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "lint": "eslint --cache src",
    "lint:fix": "eslint --fix src",
    "outdated": "bunx npm-check-updates --interactive --format group",
    "unused": "knip",
    "coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov",
    "test": "bun test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "playwright:install": "playwright install chromium"
  },
  "dependencies": {
    "@orpc/client": "^1.13.9",
    "@orpc/contract": "^1.13.9",
    "@orpc/openapi-client": "^1.13.9",
    "@tanstack/query-async-storage-persister": "^5.90.27",
    "@tanstack/react-query": "^5.91.2",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@tanstack/react-query-persist-client": "^5.90.27",
    "@tanstack/react-router": "^1.167.5",
    "carrier-contracts": "workspace:*",
    "clsx": "^2.1.1",
    "konva": "^10.2.3",
    "jotai": "^2.18.1",
    "lucide-react": "^0.577.0",
    "odgn-ts-helpers": "^0.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-konva": "^19.2.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@nkzw/eslint-config": "^3.3.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/bun": "^1.3.11",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "bun-plugin-tailwind": "^0.1.2",
    "eslint": "^10.0.3",
    "knip": "^5.88.1",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3"
  }
}